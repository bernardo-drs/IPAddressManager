<Page x:Class="Interfaces.Outils"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Interfaces"
      mc:Ignorable="d" 
      d:DesignHeight="705" d:DesignWidth="1000"
      Title="Outils" Background="#0F172A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36*"/>
            <ColumnDefinition Width="847*"/>
            <ColumnDefinition Width="36*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="79*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="573*"/>
            <RowDefinition Height="25*"/>
        </Grid.RowDefinitions>

        <Viewbox Stretch="Uniform" Grid.Column="1" Grid.Row="1" Margin="0,0,0,0" HorizontalAlignment="Left">
            <TextBlock x:Name="Title" Foreground="#F8FAFC">
            Outils
            </TextBlock>
        </Viewbox>
        <Rectangle Fill="#808080" Grid.Column="1" Grid.Row="2"></Rectangle>

        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" 
            Background="#1E293B" 
            CornerRadius="10" 
            Margin="10" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
                <Viewbox Stretch="Uniform" Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="1010&#x0a;0101" Foreground="#38BDF8" FontSize="22" FontWeight="Bold" LineHeight="20" HorizontalAlignment="Center" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBlock Text="Conversion" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBlock Text="Convertir IP, binaire,&#x0a;hexadécimal" Foreground="#94A3B8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    </StackPanel>
                </Viewbox>
            </Border>

            <Border Grid.Column="1" Grid.Row="0" 
            Background="#1E293B" 
            CornerRadius="10" 
            Margin="10" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
                <Viewbox Stretch="Uniform" Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="15" Width="40" Height="40" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <TextBlock Text="C" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text="Classe IP" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBlock Text="Déterminer la classe&#x0a;d'une adresse IP" Foreground="#94A3B8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Viewbox>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" 
            Background="#1E293B" 
            CornerRadius="10" 
            Margin="10" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
                <Viewbox Stretch="Uniform" Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="✓" Foreground="#38BDF8" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,15" FontFamily="Segoe UI Symbol"/>
                        <TextBlock Text="Tester une IP" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBlock Text="Vérifier si une IP est&#x0a; valide et son type" Foreground="#94A3B8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Viewbox>
            </Border>


            <Border Grid.Column="3" Grid.Row="0" 
            Background="#1E293B" 
            CornerRadius="10" 
            Margin="10" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
                <Viewbox Stretch="Uniform" Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="👥" Foreground="#38BDF8" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,15" FontFamily="Segoe UI Symbol"/>
                        <TextBlock Text="Nombre d'hôtes" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBlock Text="Calculer le nombre&#x0a;d'hôtes utilisables" Foreground="#94A3B8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Viewbox>
            </Border>

            <Border Grid.Column="0" Grid.Row="1" 
            Background="#1E293B" 
            CornerRadius="10" 
            Margin="10" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
                <Viewbox Stretch="Uniform" Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🌐" Foreground="#38BDF8" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" FontFamily="Segoe UI Symbol"/>
                        <TextBlock Text="Résolution IP" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBlock Text="Obtenir des informations&#x0a;sur une adresse IP" Foreground="#94A3B8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Viewbox>
            </Border>

            <Border Grid.Column="1" Grid.Row="1" 
            Background="#1E293B" 
            CornerRadius="10" 
            Margin="10" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
                <Viewbox Stretch="Uniform" Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⚙" Foreground="#38BDF8" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,12" FontFamily="Segoe UI Symbol"/>
                        <TextBlock Text="Masque Réseau" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBlock Text="Analyser un masque de&#x0a;sous-réseau ou un CIDR" Foreground="#94A3B8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Viewbox>
            </Border>

            <Border Grid.Column="2" Grid.Row="1" 
            Background="#1E293B" 
            CornerRadius="10" 
            Margin="10" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
                <Viewbox Stretch="Uniform" Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⚃" Foreground="#38BDF8" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10" FontFamily="Segoe UI Symbol"/>
                        <TextBlock Text="Découpage FLSM" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBlock Text="Sous-réseaux à masques&#x0a;fixes (Fixed Length)" Foreground="#94A3B8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Viewbox>
            </Border>

            <Border Grid.Column="3" Grid.Row="1" 
            Background="#1E293B" 
            CornerRadius="10" 
            Margin="10" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
                <Viewbox Stretch="Uniform" Margin="15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⚄" Foreground="#38BDF8" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10" FontFamily="Segoe UI Symbol"/>
                        <TextBlock Text="Découpage VLSM" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBlock Text="Sous-réseaux à masques&#x0a;variables (Variable Length)" Foreground="#94A3B8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Viewbox>
            </Border>
        </Grid>

    </Grid>
</Page>
