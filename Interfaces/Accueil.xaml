<Page x:Class="Interfaces.Accueil"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Interfaces"
      mc:Ignorable="d" 
      d:DesignHeight="705" d:DesignWidth="1000"
      Title="Accueil" Background="#0F172A">

    <!--Main Grid-->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36*"/>
            <ColumnDefinition Width="79*"/>
            <ColumnDefinition Width="847*"/>
            <ColumnDefinition Width="36*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="79*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="573*"/>
            <RowDefinition Height="25*"/>
        </Grid.RowDefinitions>

        <!--Page Icon & Title-->

        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1">
            <Image Source="/Images/home_icon.png" Margin="50"></Image>
        </Viewbox>
        <Viewbox Stretch="Uniform" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" Margin="20,0,0,0">
            <TextBlock x:Name="Title" Foreground="#F8FAFC">
                    Accueil
            </TextBlock>
        </Viewbox>
        <Rectangle Fill="#808080" Grid.Column="2" Grid.Row="2"></Rectangle>

        <!--Main-->

        <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="42*"/>
                <RowDefinition Height="73*"/>
                <RowDefinition Height="14*"/>
                <RowDefinition Height="69*"/>
                <RowDefinition Height="75*"/>
                <RowDefinition Height="258*"/>
                <RowDefinition Height="42*"/>
            </Grid.RowDefinitions>
            <Viewbox MaxWidth="300" Grid.Row="1">
                <TextBlock Foreground="#F8FAFC">Bienvenue !</TextBlock>
            </Viewbox>
            <Viewbox MaxWidth="600" Margin="0,20,0,0" Grid.Row="3">
                <TextBlock Foreground="#F8FAFC">Calculateur de Masque Réseau</TextBlock>
            </Viewbox>
            <DockPanel Grid.Row="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#1E293B" CornerRadius="20" Grid.Column="0" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel >
                            <Viewbox MaxWidth="100" MaxHeight="200" Margin="20" HorizontalAlignment="Stretch">
                                <Image Source="/Images/fast_icon.png" ></Image>
                            </Viewbox>
                            <Viewbox MaxHeight="50" HorizontalAlignment="Stretch">
                                <TextBlock Foreground="#F8FAFC">
Rapide
                                </TextBlock>
                            </Viewbox>
                            <Viewbox MaxHeight="50" Margin="15">
                                <TextBlock Foreground="#808080" TextWrapping="Wrap">
Calcul Instantané des masques
                                </TextBlock>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="20" Grid.Column="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel >
                            <Viewbox MaxWidth="100" MaxHeight="200" Margin="20" HorizontalAlignment="Stretch">
                                <Image Source="/Images/Cible.png" ></Image>
                            </Viewbox>
                            <Viewbox MaxHeight="50" HorizontalAlignment="Stretch">
                                <TextBlock Foreground="#F8FAFC">
Précis
                                </TextBlock>
                            </Viewbox>
                            <Viewbox MaxHeight="50" Margin="15" HorizontalAlignment="Stretch">
                                <TextBlock Foreground="#808080" TextWrapping="Wrap">
Résultats fiables et détaillés
                                </TextBlock>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="20" Grid.Column="2" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel >
                            <Viewbox MaxWidth="100" MaxHeight="200" Margin="20" HorizontalAlignment="Stretch">
                                <Image Source="/Images/boussole (1).png" ></Image>
                            </Viewbox>
                            <Viewbox MaxHeight="50" HorizontalAlignment="Stretch">
                                <TextBlock Foreground="#F8FAFC">
Intuitif
                                </TextBlock>
                            </Viewbox>
                            <Viewbox MaxHeight="50" Margin="15" HorizontalAlignment="Stretch">
                                <TextBlock Foreground="#808080" TextWrapping="Wrap">
Interface simple et claire
                                </TextBlock>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="20" Grid.Column="3" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel >
                            <Viewbox MaxWidth="85" MaxHeight="200" Margin="20" HorizontalAlignment="Stretch">
                                <Image Source="/Images/Complet.png" ></Image>
                            </Viewbox>
                            <Viewbox MaxHeight="50" HorizontalAlignment="Stretch">
                                <TextBlock Foreground="#F8FAFC">
Complet
                                </TextBlock>
                            </Viewbox>
                            <Viewbox MaxHeight="50" Margin="15" HorizontalAlignment="Stretch">
                                <TextBlock Foreground="#808080" TextWrapping="Wrap">
Outils réseaux avancés
                                </TextBlock>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Page>
