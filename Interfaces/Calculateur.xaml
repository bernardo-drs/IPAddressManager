<Page x:Class="Interfaces.Calculateur"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Interfaces"
      mc:Ignorable="d" 
      d:DesignHeight="705" d:DesignWidth="1000"
      Title="Calculateur" Background="#0F172A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36*"/>
            <ColumnDefinition Width="847*"/>
            <ColumnDefinition Width="36*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="79*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="573*"/>
            <RowDefinition Height="25*"/>
        </Grid.RowDefinitions>

        <Viewbox Stretch="Uniform" Grid.Column="1" Grid.Row="1" Margin="0,0,0,0" HorizontalAlignment="Left">
            <TextBlock x:Name="Title" Foreground="#F8FAFC">
            Calculateur de masque réseau
            </TextBlock>
        </Viewbox>
        <Rectangle Fill="#808080" Grid.Column="1" Grid.Row="2"></Rectangle>

        <Grid Grid.Column="1" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="0.25*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#1E293B" CornerRadius="10" Grid.Row="0" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54*"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="70*"/>
                                <RowDefinition Height="100*"/>
                            </Grid.RowDefinitions>

                            <Viewbox Grid.Row="0" MaxHeight="39" HorizontalAlignment="Left" Margin="15,5,0,0">
                                <TextBlock Foreground="#F8FAFC">
                                Remplir l'adresse IP et le masque CIDR
                                </TextBlock>
                            </Viewbox>
                            <Rectangle Fill="#808080" Grid.Row="1" Margin="15,0,15,0"></Rectangle>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0" HorizontalAlignment="Stretch" Margin="15,10,10,0">
                                    <TextBox Width="30" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxLength="3"/>
                                </Viewbox>
                                <Viewbox Grid.Column="2" HorizontalAlignment="Stretch" Margin="12.5,10,12.5,0">
                                    <TextBox Width="30" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxLength="3"></TextBox>
                                </Viewbox>
                                <Viewbox Grid.Column="4" HorizontalAlignment="Stretch" Margin="12.5,10,12.5,0">
                                    <TextBox Width="30" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxLength="3"></TextBox>
                                </Viewbox>
                                <Viewbox Grid.Column="6" HorizontalAlignment="Stretch" Margin="12.5,10,12.5,0">
                                    <TextBox Width="30" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxLength="3"></TextBox>
                                </Viewbox>
                                <Viewbox Grid.Column="8" HorizontalAlignment="Stretch" Margin="10,10,15,0">
                                    <TextBox Width="30" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxLength="2"></TextBox>
                                </Viewbox>

                                <Viewbox Grid.Column="1" HorizontalAlignment="Stretch" Margin="10,10,15,0">
                                    <TextBlock Foreground="White">.</TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="3" HorizontalAlignment="Stretch" Margin="10,10,15,0">
                                    <TextBlock Foreground="White">.</TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="5" HorizontalAlignment="Stretch" Margin="10,10,15,0">
                                    <TextBlock Foreground="White">.</TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="7" HorizontalAlignment="Stretch" Margin="10,10,15,0">
                                    <TextBlock Foreground="White">/</TextBlock>
                                </Viewbox>

                            </Grid>
                           
                        </Grid>

                    </Border>

                    <Border Background="#1E293B" CornerRadius="10" Grid.Row="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    </Border>

                </Grid>

                <Border Background="#1E293B" CornerRadius="10" Grid.Column="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                </Border>

            </Grid>

            <Border Background="#1E293B" CornerRadius="10" Grid.Row="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="65*"/>
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" MaxHeight="40" HorizontalAlignment="Left" Margin="15,5,0,0">
                        <TextBlock Foreground="#F8FAFC">
                    Visualisation Binaire
                        </TextBlock>
                    </Viewbox>
                    <Rectangle Fill="#808080" Grid.Row="1" Margin="15,0,15,0"></Rectangle>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Viewbox MaxHeight="25" Margin="15,5" HorizontalAlignment="Left">
                                <TextBlock Foreground="White"  TextWrapping="Wrap">
                            Adresse IP
                                </TextBlock>
                            </Viewbox>
                            <Viewbox MaxHeight="25" Margin="15,5" HorizontalAlignment="Left">
                                <TextBlock Foreground="White"  TextWrapping="Wrap">
                            Binary :
                                </TextBlock>
                            </Viewbox>
                            <Viewbox MaxHeight="25" Margin="15,5" HorizontalAlignment="Left">
                                <TextBlock Foreground="White"  TextWrapping="Wrap">
                            Masque de Réseau
                                </TextBlock>
                            </Viewbox>
                            <Viewbox MaxHeight="25" Margin="15,5" HorizontalAlignment="Left">
                                <TextBlock Foreground="White"  TextWrapping="Wrap">
                            Binary :
                                </TextBlock>
                            </Viewbox>
                        </StackPanel>
                        <Border Grid.Column="1" 
                            Height="32" 
                            ClipToBounds="True" 
                            VerticalAlignment="Bottom"
                            Margin="10,0,15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24*"/>
                                    <ColumnDefinition Width="8*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#72DCA3">
                                    <TextBlock Text="11111111.11111111.11111111." 
                                           FontSize="25"
                                           Foreground="White" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center" 
                                           Margin="5,0"/>
                                </Border>

                                <Border Grid.Column="1" Background="#264D73">
                                    <TextBlock Text="00000000" 
                                           Foreground="#A6C1EE" 
                                           FontSize="25"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center" 
                                           Margin="5,0"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
