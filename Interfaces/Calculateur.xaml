<Page x:Class="Interfaces.Calculateur"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Interfaces"
      mc:Ignorable="d" 
      d:DesignHeight="705" d:DesignWidth="1000"
      Title="Calculateur" Background="#0F172A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36*"/>
            <ColumnDefinition Width="847*"/>
            <ColumnDefinition Width="36*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="79*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="573*"/>
            <RowDefinition Height="25*"/>
        </Grid.RowDefinitions>

        <Viewbox Stretch="Uniform" Grid.Column="1" Grid.Row="1" Margin="0,0,0,0" HorizontalAlignment="Left">
            <TextBlock x:Name="Title" Foreground="#F8FAFC">
            Calculateur de masque réseau
            </TextBlock>
        </Viewbox>
        <Rectangle Fill="#808080" Grid.Column="1" Grid.Row="2"></Rectangle>

        <Grid Grid.Column="1" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="0.25*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#1E293B" CornerRadius="10" Grid.Row="0" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54*"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="70*"/>
                                <RowDefinition Height="50*"/>
                                <RowDefinition Height="50*"/>
                            </Grid.RowDefinitions>

                            <Viewbox Grid.Row="0" MaxHeight="39" HorizontalAlignment="Left" Margin="15,5,0,0">
                                <TextBlock Foreground="#F8FAFC">
                                Remplir l'adresse IP et le masque CIDR
                                </TextBlock>
                            </Viewbox>
                            <Rectangle Fill="#808080" Grid.Row="1" Margin="15,0,15,0"></Rectangle>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0" HorizontalAlignment="Stretch" Margin="15,10,10,0">
                                    <TextBox x:Name="TxtIp1" Width="30" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxLength="3"/>
                                </Viewbox>
                                <Viewbox Grid.Column="2" HorizontalAlignment="Stretch" Margin="12.5,10,12.5,0">
                                    <TextBox x:Name="TxtIp2" Width="30" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxLength="3"></TextBox>
                                </Viewbox>
                                <Viewbox Grid.Column="4" HorizontalAlignment="Stretch" Margin="12.5,10,12.5,0">
                                    <TextBox x:Name="TxtIp3" Width="30" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxLength="3"></TextBox>
                                </Viewbox>
                                <Viewbox Grid.Column="6" HorizontalAlignment="Stretch" Margin="12.5,10,12.5,0">
                                    <TextBox x:Name="TxtIp4" Width="30" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxLength="3"></TextBox>
                                </Viewbox>
                                <Viewbox Grid.Column="8" HorizontalAlignment="Stretch" Margin="10,10,15,0">
                                    <TextBox x:Name="TxtCidr"
                                             Width="30" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxLength="2" TextChanged="TxtCidr_TextChanged"></TextBox>
                                </Viewbox>

                                <Viewbox Grid.Column="1" HorizontalAlignment="Stretch" Margin="10,10,15,0">
                                    <TextBlock Foreground="White">.</TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="3" HorizontalAlignment="Stretch" Margin="10,10,15,0">
                                    <TextBlock Foreground="White">.</TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="5" HorizontalAlignment="Stretch" Margin="10,10,15,0">
                                    <TextBlock Foreground="White">.</TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="7" HorizontalAlignment="Stretch" Margin="10,10,15,0">
                                    <TextBlock Foreground="White">/</TextBlock>
                                </Viewbox>

                            </Grid>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" MaxHeight="30" HorizontalAlignment="Left" Margin="15,5,0,0">
                                    <TextBlock Foreground="#F8FAFC">
                                    Masque en décimal
                                    </TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="1" MaxHeight="30" HorizontalAlignment="Left" Margin="15,5,0,0">
                                    <TextBlock Foreground="#F8FAFC">
                                    Classe de l'adresse IP
                                    </TextBlock>
                                </Viewbox>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#0F172A" CornerRadius="10" Grid.Column="0" Margin="10,10,10,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Viewbox MaxHeight="35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,5,0,0">
                                        <TextBlock x:Name="TxtDecimal" Foreground="#F8FAFC">

                                        </TextBlock>
                                    </Viewbox>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="10" Grid.Column="1" Margin="10,10,10,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Viewbox MaxHeight="35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,5,0,0">
                                        <TextBlock  x:Name="TxtClasseIp" Foreground="#F8FAFC">

                                        </TextBlock>
                                    </Viewbox>
                                </Border>
                            </Grid>
                        </Grid>

                    </Border>

                    <Border x:Name="BtnCalculer" Background="#1E293B" CornerRadius="10" Grid.Row="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            MouseEnter="BtnCalculer_MouseEnter" 
                            MouseLeave="BtnCalculer_MouseLeave" MouseDown="BtnCalculer_MouseDown">
                        <Button Background="#1E293B" BorderThickness="0" OverridesDefaultStyle="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Viewbox Stretch="Uniform" MaxWidth="150" MaxHeight="40" >
                                        <TextBlock Margin="15,0,0,0" Foreground="White" FontStretch="Normal" FontSize="25">
                                        Calculer
                                        </TextBlock>
                                    </Viewbox>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                </Grid>

                <Border Background="#1E293B" CornerRadius="10" Grid.Column="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="39*"/>
                            <RowDefinition Height="1.5*"/>
                            <RowDefinition Height="28.3*"/>
                            <RowDefinition Height="28.3*"/>
                            <RowDefinition Height="28.3*"/>
                            <RowDefinition Height="28.3*"/>
                            <RowDefinition Height="28.3*"/>
                            <RowDefinition Height="28.3*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="0.75*"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Row="0" Grid.ColumnSpan="2" MaxHeight="39" HorizontalAlignment="Left" Margin="15,5,0,0">
                            <TextBlock Foreground="#F8FAFC">
                               Information Réseau
                            </TextBlock>
                        </Viewbox>
                        <Rectangle Fill="#808080" Grid.Row="1" Margin="15,0,15,0" Grid.ColumnSpan="2"></Rectangle>

                        <Viewbox Grid.Row="2" Grid.Column="0" MaxHeight="23" HorizontalAlignment="Left" Margin="15,5,0,5">
                            <TextBlock Foreground="#F8FAFC">
                                Adresse Réseau :
                            </TextBlock>
                        </Viewbox>
                        <Viewbox Grid.Row="3" Grid.Column="0" MaxHeight="23" HorizontalAlignment="Left" Margin="15,5,0,5">
                            <TextBlock Foreground="#F8FAFC">
                                Première Adresse Hôte :
                            </TextBlock>
                        </Viewbox>
                        <Viewbox Grid.Row="4" Grid.Column="0" MaxHeight="23" HorizontalAlignment="Left" Margin="15,5,0,5">
                            <TextBlock Foreground="#F8FAFC">
                                Dernière Adresse Hôte :
                            </TextBlock>
                        </Viewbox>
                        <Viewbox Grid.Row="5" Grid.Column="0" MaxHeight="23" HorizontalAlignment="Left" Margin="15,5,0,5">
                            <TextBlock Foreground="#F8FAFC">
                                Adresse de Broadcast :
                            </TextBlock>
                        </Viewbox>
                        <Viewbox Grid.Row="7" Grid.ColumnSpan="2" MaxHeight="23" HorizontalAlignment="Left" Margin="15,5,0,5">
                            <TextBlock Foreground="#F8FAFC">
                                Nombre d'IPs Valides :
                            </TextBlock>
                        </Viewbox>
                        <Viewbox Grid.Row="6" Grid.ColumnSpan="2" MaxHeight="23" HorizontalAlignment="Left" Margin="15,5,0,5">
                            <TextBlock Foreground="#F8FAFC">
                                Nombre d'IPs  :
                            </TextBlock>
                        </Viewbox>

                        <Border Background="#0F172A" CornerRadius="10" Grid.Column="1" Grid.Row="2" Margin="10,10,15,5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Viewbox Grid.Column="1" MaxHeight="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock x:Name="TxtAdresse" Foreground="#F8FAFC">
                                
                                </TextBlock>
                            </Viewbox>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="10" Grid.Column="1" Grid.Row="3" Margin="10,7.5,15,7.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Viewbox Grid.Column="1" MaxHeight="35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock x:Name="TxtPremièreAdresse" Foreground="#F8FAFC">
                                
                                </TextBlock>
                            </Viewbox>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="10" Grid.Column="1" Grid.Row="4" Margin="10,7.5,15,7.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Viewbox Grid.Column="1" MaxHeight="35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock x:Name="TxtDernièreAdresse" Foreground="#F8FAFC">
                              
                                </TextBlock>
                            </Viewbox>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="10" Grid.Column="1" Grid.Row="5" Margin="10,7.5,15,7.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Viewbox Grid.Column="1" MaxHeight="35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock x:Name="TxtBroadcast" Foreground="#F8FAFC">
                          
                                </TextBlock>
                            </Viewbox>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="10" Grid.Column="1" Grid.Row="7" Margin="10,5,15,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Viewbox Grid.Column="1" MaxHeight="35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock x:Name="TxtNombreHôte" Foreground="#F8FAFC" Margin="0,0,0,0">

                                </TextBlock>
                            </Viewbox>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="10" Grid.Column="1" Grid.Row="6" Margin="10,7.5,15,7.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Viewbox Grid.Column="1" MaxHeight="35" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock x:Name="TxtNombreIP" Foreground="#F8FAFC">

                                </TextBlock>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>

            </Grid>

            <Border Background="#1E293B" CornerRadius="10" Grid.Row="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="65*"/>
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" MaxHeight="40" HorizontalAlignment="Left" Margin="15,5,0,0">
                        <TextBlock Foreground="#F8FAFC">
                    Visualisation Binaire
                        </TextBlock>
                    </Viewbox>
                    <Rectangle Fill="#808080" Grid.Row="1" Margin="15,0,15,0"></Rectangle>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" MaxHeight="25" Margin="15,5" HorizontalAlignment="Left">
                                <TextBlock Foreground="White"  TextWrapping="Wrap">
                            Adresse IP
                                </TextBlock>
                            </Viewbox>
                            <Viewbox Grid.Row="1" MaxHeight="25" Margin="15,5" HorizontalAlignment="Left">
                                <TextBlock Foreground="White"  TextWrapping="Wrap">
                            Binaire :
                                </TextBlock>
                            </Viewbox>
                            <Viewbox Grid.Row="2" MaxHeight="25" Margin="15,5" HorizontalAlignment="Left">
                                <TextBlock Foreground="White"  TextWrapping="Wrap">
                            Masque de Réseau
                                </TextBlock>
                            </Viewbox>
                            <Viewbox Grid.Row="3" MaxHeight="25" Margin="15,5" HorizontalAlignment="Left">
                                <TextBlock Foreground="White"  TextWrapping="Wrap">
                            Binaire :
                                </TextBlock>
                            </Viewbox>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Background="#0F172A"
                                Height="32" 
                                ClipToBounds="True" 
                                Margin="10,0,15,15"
                                VerticalAlignment="Center"
                                CornerRadius="10">
                                <Border >
                                    <TextBlock x:Name="TxtBinIpComplete"
                                            FontSize="25"
                                            Foreground="#72DCA3" 
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Center" 
                                            Margin="5,0"/>
                                </Border>
                            </Border>
                            <Border 
                                Grid.Row="1"
                                Height="32" 
                                ClipToBounds="True" 
                                VerticalAlignment="Center"
                                Margin="10,0,15,15"
                                CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24*"/>
                                        <ColumnDefinition Width="8*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#72DCA3" CornerRadius="10">
                                        <TextBlock x:Name="TxtBinMasqueUn"
                                           FontSize="25"
                                           Foreground="White" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center" 
                                           Margin="5,0"
                                           />
                                    </Border>

                                    <Border Grid.Column="1" Background="#264D73" CornerRadius="10">
                                        <TextBlock x:Name="TxtBinMasqueZero"
                                           Foreground="#A6C1EE" 
                                           FontSize="25"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center" 
                                           Margin="5,0"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
